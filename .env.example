# Copy to .env and fill in. .env is gitignored.

# OpenIE (entity + triple extraction) runs on Together
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Embeddings. Leave OPENAI_API_KEY blank to run embeddings on Together too.
# Only e5-large is serverless on Together; the BAAI/bge-* models 400 with
# model_not_available and would need a dedicated endpoint.
# Set OPENAI_API_KEY and EMBED_MODEL=text-embedding-3-small to use OpenAI instead.
OPENAI_API_KEY=
EMBED_MODEL=intfloat/multilingual-e5-large-instruct
